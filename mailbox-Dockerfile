FROM python:3.11-slim
ENV LANG C.UTF-8
ENV LC_ALL C.UTF-8
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND noninteractive
# 7-Zip (archives, ISO/VHD), poppler (PDF first-page preview), zbar (QR codes; the library is
# libzbar0t64 from Debian 13, libzbar0 before)
RUN apt-get update && apt-get install -y --no-install-recommends 7zip poppler-utils \
    && (apt-get install -y --no-install-recommends libzbar0t64 || apt-get install -y --no-install-recommends libzbar0) \
    && rm -rf /var/lib/apt/lists/*
COPY mailbox-requirements.txt .
RUN pip install --no-cache-dir -r mailbox-requirements.txt
ADD ./rules /rules
ADD ./mailbox /mailbox
WORKDIR /mailbox
# Parses untrusted messages: run unprivileged (the worker also drops all capabilities,
# disables the network and mounts the root filesystem read-only).
USER 65534:65534
ENTRYPOINT ["python", "run.py"]
